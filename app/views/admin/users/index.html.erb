<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold">作業者の管理</h1>

  <% if notice.present? %>
    <p class="mb-4 text-primary"><%= notice %></p>
  <% end %>

  <%= render "shared/invitation_box" %>

  <div class="mb-4">
    <%= link_to "作業者を追加", new_admin_user_path,
        class: "px-4 py-2 rounded-lg bg-primary text-background-dark font-bold" %>
  </div>

  <ul id="admin-user-list" class="space-y-2">
    <% @users.each do |user| %>
      <li class="flex items-center justify-between gap-3 p-3 rounded-lg border border-neutral-border">
        <div>
          <p class="font-bold"><%= user.name %></p>
          <p class="text-sm text-slate-400"><%= user.email %></p>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm"><%= role_label(user.role) %></span>
          <%= link_to "編集", edit_admin_user_path(user) %>
          <%= button_to "招待URLを再発行", invitation_admin_user_path(user), method: :post,
              form: { data: { turbo: false } }, class: "text-sm underline" %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
