<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold">区分</h1>

  <% if notice.present? %>
    <p class="mb-4 text-primary"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="mb-4 text-red-500" role="alert"><%= alert %></p>
  <% end %>

  <p class="mb-4 text-sm text-slate-400">
    元請けに出す見積の内訳の項目です（伐採費・整理費・機械費・処分費など）。
  </p>

  <%= form_with model: @cost_category, url: admin_cost_categories_path, data: { turbo: false }, class: "mb-6" do |form| %>
    <% if @cost_category.errors.any? %>
      <div class="mb-2 text-red-500" role="alert">
        <% @cost_category.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form.label :name, "区分の名前" %>
    <div class="flex gap-2">
      <%= form.text_field :name, required: true, maxlength: 30, class: "w-full" %>
      <%= form.submit "追加", class: "px-4 py-2 rounded-lg bg-primary text-background-dark font-bold" %>
    </div>
  <% end %>

  <% if @cost_categories.empty? %>
    <p>区分はまだ登録されていません。</p>
  <% else %>
    <ul id="cost-category-list" class="space-y-2">
      <% @cost_categories.each do |category| %>
        <li class="flex items-center justify-between gap-3 p-3 rounded-lg border border-neutral-border">
          <div>
            <p class="font-bold"><%= category.name %></p>
            <p class="text-sm text-slate-400">単価マスタの項目: <%= category.cost_items.size %>件</p>
          </div>
          <div class="flex items-center gap-3">
            <%= link_to "編集", edit_admin_cost_category_path(category) %>
            <%= button_to "削除", admin_cost_category_path(category), method: :delete,
                form: { data: { turbo_confirm: "「#{category.name}」を削除しますか？" } }, class: "text-sm underline" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <ul class="mt-8 space-y-2">
    <li><%= link_to "単価マスタ", admin_cost_items_path %></li>
    <li><%= link_to "見積の設定に戻る", edit_admin_estimate_setting_path %></li>
  </ul>
</div>
