<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold">見積の設定</h1>

  <% if notice.present? %>
    <p class="mb-4 text-primary"><%= notice %></p>
  <% end %>

  <p class="mb-6 text-sm text-slate-400">
    見積を作るときに、この設定が使われます。原価と利益率は管理者だけが見られます（作業者には表示されません）。
  </p>

  <%= form_with model: @estimate_setting, url: admin_estimate_setting_path, data: { turbo: false } do |form| %>
    <% if @estimate_setting.errors.any? %>
      <div class="mb-4 text-red-500" role="alert">
        <% @estimate_setting.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <fieldset class="mb-6">
      <legend class="mb-2 font-bold">利益率の定義</legend>
      <div class="space-y-2">
        <% EstimateSetting.margin_bases.each_key do |basis| %>
          <label class="flex items-center gap-2">
            <%= form.radio_button :margin_basis, basis %>
            <%= margin_basis_label(basis) %>
          </label>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-slate-400">
        例: 原価100円で利益率30%のとき、「売価に対する割合」なら売価は約142.9円、「原価に上乗せ」なら130円です。
      </p>
    </fieldset>

    <div class="mb-4">
      <%= form.label :margin_rate, "利益率（%）" %>
      <%= form.text_field :margin_rate, inputmode: :decimal, required: true, class: "w-full" %>
    </div>

    <div class="mb-4">
      <%= form.label :overhead_rate, "諸経費率（直接費に対して %）" %>
      <%= form.text_field :overhead_rate, inputmode: :decimal, required: true, class: "w-full" %>
    </div>

    <div class="mb-4">
      <%= form.label :rounding_unit, "売価の端数の単位" %>
      <%= form.select :rounding_unit, rounding_unit_options, {}, class: "w-full" %>
    </div>

    <div class="mb-4">
      <%= form.label :rounding_mode, "端数の処理" %>
      <%= form.select :rounding_mode, rounding_mode_options, {}, class: "w-full" %>
    </div>

    <div class="mb-4">
      <%= form.label :tax_rate, "消費税率（%）" %>
      <%= form.text_field :tax_rate, inputmode: :decimal, required: true, class: "w-full" %>
    </div>

    <div class="mb-4">
      <%= form.label :tax_rounding_mode, "消費税の端数の処理" %>
      <%= form.select :tax_rounding_mode, tax_rounding_mode_options, {}, class: "w-full" %>
      <p class="mt-2 text-sm text-slate-400">利益の計算は税抜で行い、消費税は売価（税抜）にかけて出します。見積を作った時点の値が、その見積に残ります。</p>
    </div>

    <div class="mb-4">
      <%= form.label :number_prefix, "見積番号の頭の文字" %>
      <%= form.text_field :number_prefix, maxlength: 10, class: "w-full" %>
      <p class="mt-2 text-sm text-slate-400">例: 「見積-」なら 見積-0001。作成済みの見積の番号は変わりません。</p>
    </div>

    <div class="mb-4">
      <%= form.label :area_input_unit, "面積を入力するときの単位（初期値）" %>
      <%= form.select :area_input_unit, area_input_unit_options, {}, class: "w-full" %>
      <p class="mt-2 text-sm text-slate-400">見積の面積を入力する画面で、最初に選ばれている単位です。保存はどちらも㎡です。</p>
    </div>

    <div class="mb-6">
      <%= form.label :area_price_rounding_unit, "㎡単価の端数の単位" %>
      <%= form.select :area_price_rounding_unit, area_price_rounding_unit_options, {}, class: "w-full" %>
      <p class="mt-2 text-sm text-slate-400">
        売価を面積で割った㎡単価の端数です。端数の処理（切り上げなど）は、売価と同じです。
      </p>
    </div>

    <fieldset class="mb-6 rounded-xl border border-neutral-border p-4">
      <legend class="px-2 font-bold">提出書に載せる自社の情報</legend>
      <p class="mb-4 text-sm text-slate-400">
        元請けに出す見積書（提出画面）に載ります。見積ごとではなく、会社で1つです。
      </p>

      <div class="mb-4">
        <%= form.label :issuer_name, "社名" %>
        <%= form.text_field :issuer_name, maxlength: 50, class: "w-full" %>
        <p class="mt-2 text-sm text-slate-400">空欄のときは、組織の名前「<%= current_user.organization.name %>」を使います。</p>
      </div>

      <div class="mb-4">
        <%= form.label :issuer_address, "住所" %>
        <%= form.text_field :issuer_address, maxlength: 100, class: "w-full" %>
      </div>

      <div class="mb-4">
        <%= form.label :issuer_phone, "電話番号" %>
        <%= form.text_field :issuer_phone, maxlength: 20, inputmode: :tel, class: "w-full" %>
      </div>

      <div>
        <%= form.label :submission_note, "備考（提出書の下に載せる文章）" %>
        <%= form.text_area :submission_note, rows: 4, maxlength: 500, class: "w-full" %>
        <p class="mt-2 text-sm text-slate-400">例: 有効期限、支払条件、お見積りに含まれないもの。</p>
      </div>
    </fieldset>

    <%= form.submit "設定を保存", class: "px-4 py-2 rounded-lg bg-primary text-background-dark font-bold" %>
  <% end %>

  <ul class="mt-8 space-y-2">
    <li><%= link_to "区分を管理する（伐採費・整理費など）", admin_cost_categories_path %></li>
    <li><%= link_to "単価マスタを管理する（人工・機械・処分など）", admin_cost_items_path %></li>
  </ul>
</div>
