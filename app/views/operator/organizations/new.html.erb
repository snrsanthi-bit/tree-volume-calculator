<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-4 text-2xl font-bold">組織を追加</h1>
  <p class="mb-6 text-sm text-slate-400">組織と最初の管理者を作ります。追加すると招待URLが表示されるので、管理者に渡してください。</p>

  <%= form_with model: [:operator, @organization], data: { turbo: false } do |form| %>
    <% errors = @organization.errors.full_messages %>
    <% if errors.any? %>
      <div class="mb-4 text-red-500">
        <% errors.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-4">
      <%= form.label :name, "組織名" %>
      <%= form.text_field :name, required: true, class: "w-full" %>
    </div>

    <%= fields_for :admin, @admin do |admin| %>
      <div class="mb-4">
        <%= admin.label :name, "管理者の名前" %>
        <%= admin.text_field :name, required: true, class: "w-full" %>
      </div>

      <div class="mb-4">
        <%= admin.label :email, "管理者のメールアドレス" %>
        <%= admin.email_field :email, required: true, class: "w-full" %>
      </div>
    <% end %>

    <%= form.submit "追加する", class: "px-4 py-2 rounded-lg bg-primary text-background-dark font-bold" %>
  <% end %>

  <div class="mt-6"><%= link_to "組織の管理に戻る", operator_organizations_path %></div>
</div>
