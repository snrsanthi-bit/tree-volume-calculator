<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-2 text-2xl font-bold"><%= @organization.name %></h1>
  <p class="mb-6"><%= link_to "組織名を変更", edit_operator_organization_path(@organization) %></p>

  <% if notice.present? %>
    <p class="mb-4 text-primary"><%= notice %></p>
  <% end %>

  <%= render "shared/invitation_box" %>

  <div class="mb-4">
    <%= link_to "アカウントを追加", new_operator_organization_user_path(@organization),
        class: "px-4 py-2 rounded-lg bg-primary text-background-dark font-bold" %>
  </div>

  <ul id="operator-user-list" class="space-y-2">
    <% @users.each do |user| %>
      <li class="flex items-center justify-between gap-3 p-3 rounded-lg border border-neutral-border">
        <div>
          <p class="font-bold"><%= user.name %></p>
          <p class="text-sm text-slate-400"><%= user.email %></p>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm"><%= role_label(user.role) %></span>
          <% unless user.operator? %>
            <%= button_to "招待URLを再発行", invitation_operator_organization_user_path(@organization, user),
                method: :post, form: { data: { turbo: false } }, class: "text-sm underline" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="mt-6"><%= link_to "組織の管理に戻る", operator_organizations_path %></div>
</div>
