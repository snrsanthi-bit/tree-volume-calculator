<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-4 text-2xl font-bold"><%= @organization.name %>：アカウントを追加</h1>
  <p class="mb-6 text-sm text-slate-400">追加すると招待URLが表示されます。本人がそのURLを開いてパスワードを設定します。</p>

  <%= form_with model: [:operator, @organization, @user], data: { turbo: false } do |form| %>
    <% if @user.errors.any? %>
      <div class="mb-4 text-red-500">
        <% @user.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-4">
      <%= form.label :name, "名前" %>
      <%= form.text_field :name, required: true, class: "w-full" %>
    </div>

    <div class="mb-4">
      <%= form.label :email, "メールアドレス" %>
      <%= form.email_field :email, required: true, class: "w-full" %>
    </div>

    <div class="mb-4">
      <%= form.label :role, "権限" %>
      <%= form.select :role, assignable_role_options, {}, class: "w-full" %>
    </div>

    <%= form.submit "追加する", class: "px-4 py-2 rounded-lg bg-primary text-background-dark font-bold" %>
  <% end %>

  <div class="mt-6"><%= link_to "組織に戻る", operator_organization_path(@organization) %></div>
</div>
