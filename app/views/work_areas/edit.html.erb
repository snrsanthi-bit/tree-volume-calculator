<div class="mx-auto max-w-3xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold">作業範囲の編集</h1>

  <details class="mb-4 rounded-lg border border-neutral-border p-3 text-sm">
    <summary class="cursor-pointer font-bold">使い方</summary>
    <ol class="mt-2 list-decimal space-y-1 pl-5 text-slate-300">
      <li>外周点・補助点・補助線のボタンで、地図に追加するものを切り替えます（選んでいるボタンに色が付きます）。</li>
      <li>地図をクリックして、点を追加します。</li>
      <li>消したい点を選んで、キーボードの D キーを押すと削除できます。点を消すと、その点につながる線も消えます。</li>
      <li>外周点を消すと、三角形の分け方が自動で作り直されます（線を自分で編集したあとは、作り直されません）。実測値が入っている線が消えるときは、確認が表示されます。</li>
      <li>「変更を保存」を押すと反映されます。辺の長さは、詳細画面で入力します。</li>
    </ol>
  </details>

  <% if @work_area.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-500/50 bg-red-500/10 p-3 text-sm text-red-400" role="alert">
      <% @work_area.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @work_area, data: { turbo: false } do |form| %>
    <div class="mb-4">
      <%= form.label :name, "作業範囲名", class: "mb-1 block text-sm font-bold" %>
      <%= form.text_field :name, required: true,
          class: "w-full rounded-lg border border-neutral-border bg-transparent px-3 py-2" %>
    </div>

    <%# 選択中のモードは aria-pressed="true" で色が付く %>
    <div class="mb-3 flex flex-wrap gap-2">
      <% [["outline-mode-button", "外周点", "true"],
          ["auxiliary-point-mode-button", "補助点", "false"],
          ["auxiliary-line-mode-button", "補助線", "false"]].each do |id, label, pressed| %>
        <button
          type="button"
          id="<%= id %>"
          aria-pressed="<%= pressed %>"
          class="rounded-lg border border-neutral-border px-4 py-2 hover:bg-neutral-dark aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:font-bold aria-pressed:text-background-dark"
        >
          <%= label %>
        </button>
      <% end %>
    </div>

    <div>
      <%# 実測値を入力している間も地図が見えるよう、地図と頂点数は画面上部に固定する %>
      <div class="sticky top-0 z-10 bg-background-dark pb-2 pt-1">
        <div
          id="map"
          class="mb-2 h-44 w-full rounded-xl sm:h-72"
          data-map-bounds="japan"
          data-work-area-coordinates="<%= @work_area.coordinates.to_json %>"
        ></div>

        <div class="space-y-0.5 text-sm">
          <p id="work-area-vertex-count" class="font-bold">
            頂点数：<%= @work_area.coordinates.length %>点
          </p>
          <p id="work-area-message" class="text-slate-400">
            地図をクリックして頂点を追加できます。
          </p>
          <p id="survey-area-estimated" class="text-slate-300"></p>
        </div>
      </div>

      <div
        id="triangle-list"
        class="mt-3 space-y-6"
        data-survey-cards="edit"
      ></div>
    </div>

    <%= form.hidden_field :coordinates, value: @work_area.coordinates.to_json %>
    <%= form.hidden_field :survey_data,
      value: (@work_area.survey_data || {}).to_json,
      id: "work-area-survey-data" %>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= form.submit "変更を保存",
          class: "cursor-pointer rounded-lg bg-primary px-4 py-2 font-bold text-background-dark hover:opacity-80" %>
      <%= link_to "詳細に戻る", work_area_path(@work_area),
          class: "rounded-lg border border-neutral-border px-4 py-2 hover:bg-neutral-dark" %>
      <%= link_to "一覧に戻る", work_areas_path,
          class: "rounded-lg border border-neutral-border px-4 py-2 hover:bg-neutral-dark" %>
    </div>
  <% end %>
</div>
